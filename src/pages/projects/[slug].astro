---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Window from '../../components/ui/Window.astro';
import Layers from '../../components/ui/Layers.astro';
import Terminals from '../../components/ui/Terminals.astro';
import TestGrid from '../../components/ui/TestGrid.astro';
import { art } from '../../data/art';
import { demos } from '../../data/demos';
import { mailto } from '../../data/profile';
import { projects, type Project } from '../../data/projects';

export const getStaticPaths = (() =>
  projects.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, next: projects[(i + 1) % projects.length] },
  }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
  next: Project;
}

const { project, next } = Astro.props;
const figures = project.art.map((id) => art[id]);
const work = project.kind === 'work';
const back = work ? { href: '/#experience', label: '← Experience' } : { href: '/#projects', label: '← Projects' };
const demo = demos[project.slug];
---

<Base title={project.name} description={`${project.name}: ${project.tagline}. ${project.summary}`}>
  <article>
    <header class="head wrap">
      <a class="back" href={back.href}>{back.label}</a>
      <p class="label meta">{project.org} · {work ? 'Professional work' : 'Personal project'} · {project.badge}</p>
      <h1 class="display-xl" data-split>{project.name}</h1>
      <p class="tagline display-s" data-reveal>{project.tagline}</p>
      <ul class="tags head__tags" data-reveal>
        {project.stack.map((s) => <li>{s}</li>)}
      </ul>
    </header>

    <div class="wrap">
      <Window title={`FIG. 1 — ${figures[0].caption}`} tone="white" class="figure" data-reveal>
        <div data-media>
          <img src={project.image} alt={figures.map((f) => f.caption).join('; ')} width="1400" height="960" />
        </div>
      </Window>
      <p class="credit label">
        {
          figures.map((f, i) => (
            <>
              {i > 0 && ' · '}
              <a href={f.page} target="_blank" rel="noopener">
                {f.author}, {f.date}
              </a>{' '}
              ({f.license})
            </>
          ))
        }
      </p>
    </div>

    <section class="band band--card body" aria-label="Case study">
      <div class="wrap grid">
        <div class="col" data-reveal>
          <h2 class="label">Context</h2>
          <p class="lede">{project.context}</p>
          <p class="summary">{project.summary}</p>
        </div>
        <div class="col">
          <h2 class="label">What I Built</h2>
          <ol class="built" data-stagger>
            {
              project.highlights.map((h, i) => (
                <li>
                  <span class="chip">{String(i + 1).padStart(2, '0')}</span>
                  <p>{h}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      {
        (project.layers || demo) && (
          <div class="wrap extras">
            {project.layers && (
              <div class="extra extra--layers" data-reveal>
                <h2 class="label">How It Fits Together</h2>
                <Layers layers={project.layers} />
              </div>
            )}
            {demo && (
              <div class="extra" data-reveal>
                <h2 class="label">
                  {demo.label} — {demo.title}
                </h2>
                {demo.terminals && <Terminals terminals={demo.terminals} />}
                {demo.tests && <TestGrid {...demo.tests} />}
                <p class="label note">{demo.note}</p>
              </div>
            )}
          </div>
        )
      }

      <div class="wrap">
        <div class="crop next">
          <a class="big-link display-m" href={`/projects/${next.slug}`}>Next: {next.name}</a>
          <svg class="arrows" viewBox="0 0 60 22" aria-hidden="true" data-arrows>
            <path d="M0 0l12 11L0 22z" fill="currentColor"></path>
            <path d="M18 0l12 11-12 11z" fill="currentColor"></path>
            <path d="M36 0l12 11-12 11z" fill="currentColor"></path>
          </svg>
          <a class="big-link display-m" href={mailto}>Email Me</a>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .head {
    padding: calc(var(--bar-h) + clamp(48px, 7vw, 96px)) 0 clamp(40px, 5vw, 64px);
  }
  .back {
    display: inline-block;
    font: 22px/1 var(--font-pixel);
    text-decoration: none;
    background: var(--ink);
    color: var(--paper);
    padding: 4px 6px 2px;
    transition: transform 160ms var(--ease-out);
  }
  .back:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .back:hover {
      background: var(--blue);
    }
  }
  .meta {
    margin-top: clamp(40px, 5vw, 64px);
  }
  h1 {
    margin-top: 16px;
  }
  .tagline {
    margin-top: 22px;
    max-width: 22em;
    color: var(--ink-2);
  }
  .head__tags {
    margin-top: 28px;
  }

  .figure {
    box-shadow: 8px 8px 0 var(--ink);
  }
  .figure :global(.win__body) {
    padding: 0;
    overflow: hidden;
  }
  .figure img {
    width: 100%;
    height: auto;
  }
  .credit {
    margin: 18px 0 clamp(64px, 8vw, 110px);
    font-weight: 400;
  }
  .credit a {
    text-underline-offset: 2px;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px clamp(24px, 4vw, 64px);
  }
  .col > .label {
    margin-bottom: 40px;
  }
  .lede {
    max-width: 34ch;
  }
  .summary {
    margin-top: 28px;
    max-width: 44ch;
    font-size: 18px;
    line-height: 1.22;
  }
  .built {
    list-style: none;
    padding: 0;
    display: grid;
  }
  .built li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 16px;
    align-items: baseline;
    padding: 14px 0 16px;
    border-bottom: 1px solid currentColor;
    font-size: clamp(1.1rem, 1.5vw, 1.3rem);
    line-height: 1.16;
  }
  .built li:first-child {
    padding-top: 0;
  }

  .extras {
    display: grid;
    gap: clamp(56px, 7vw, 96px);
    margin-top: clamp(72px, 9vw, 120px);
  }
  .extra > .label {
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom: 1px solid currentColor;
  }
  .extra--layers :global(.layers) {
    max-width: 640px;
  }
  .note {
    margin-top: 12px;
    font-weight: 400;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: clamp(80px, 10vw, 140px);
    padding: clamp(32px, 4vw, 52px) clamp(16px, 3vw, 40px);
  }
  .arrows {
    width: clamp(40px, 4.2vw, 58px);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .next {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
