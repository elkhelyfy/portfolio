---
import SectionHead from '../ui/SectionHead.astro';
import Window from '../ui/Window.astro';
import { experience } from '../../data/experience';
import { bySlug } from '../../data/projects';

const since = new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(new Date(experience.since));
const projects = experience.projects.map(bySlug);

function tenure(from: string, now = new Date()) {
  const start = new Date(from);
  const months = (now.getFullYear() - start.getFullYear()) * 12 + now.getMonth() - start.getMonth();
  return { years: Math.floor(months / 12), months: months % 12 };
}
const t = tenure(experience.since);
---

<section id="experience" class="band band--blue experience" aria-labelledby="experience-title">
  <div class="wrap">
    <SectionHead index="02" label={experience.label} headline={experience.headline} id="experience-title" />

    <div class="grid">
      <aside class="job-col">
        <Window title={`${experience.company} ▪ ${since} → now`} class="job" data-reveal>
          <p class="job__role"><span class="chip">{experience.role}</span> {experience.focus}</p>
          <p class="job__where">{experience.company} · {experience.location}</p>
          <p class="job__tenure">
            tenure:{' '}<span data-tenure={experience.since}>{t.years} yrs {t.months} mos</span>
          </p>
          <p class="job__summary">{experience.summary}</p>
          <ul class="job__duties">
            {experience.duties.map((d) => <li>{d}</li>)}
          </ul>
          <dl class="job__stats">
            {
              experience.stats.map((s) => (
                <div>
                  <dt>{s.label}</dt>
                  <dd>{s.value}</dd>
                </div>
              ))
            }
          </dl>
        </Window>
      </aside>

      <div class="projects">
        <h3 class="label projects__label" data-reveal>{experience.projectsLabel}</h3>
        {
          projects.map((p, i) => (
            <article class="xp" data-reveal>
              <a class="xp__media" href={`/projects/${p.slug}`} tabindex="-1" aria-hidden="true" data-media>
                <img src={p.image} alt="" width="1400" height="960" loading="lazy" decoding="async" />
              </a>
              <div class="xp__body">
                <p class="label xp__meta">
                  {String(i + 1).padStart(2, '0')} · {p.badge}
                </p>
                <h4 class="xp__name">
                  <a href={`/projects/${p.slug}`}>{p.name}</a>
                </h4>
                <p class="xp__tagline">{p.tagline}</p>
                <ul class="xp__list">
                  {p.highlights.slice(0, 3).map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
                <ul class="tags">
                  {p.stack.slice(0, 5).map((s) => (
                    <li>{s}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="crop highlight">
      <p class="display-l highlight__lines">
        {experience.highlight.lines.map((l, i) => <span data-slide={i % 2 ? 'right' : 'left'}>{l}</span>)}
      </p>
      <p class="label highlight__note">
        {experience.highlight.note}{' '}<a href={experience.highlight.link.href}>({experience.highlight.link.label})</a>
      </p>
    </div>
  </div>
</section>

<script>
  // years and months at the current job, kept current without a rebuild
  document.querySelectorAll<HTMLElement>('[data-tenure]').forEach((el) => {
    const start = new Date(el.dataset.tenure!);
    const now = new Date();
    const months = (now.getFullYear() - start.getFullYear()) * 12 + now.getMonth() - start.getMonth();
    el.textContent = `${Math.floor(months / 12)} yrs ${months % 12} mos`;
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: clamp(32px, 4.5vw, 72px);
    align-items: start;
  }

  .job-col {
    position: sticky;
    top: calc(var(--bar-h) + 24px);
  }
  .job {
    box-shadow: 8px 8px 0 var(--ink);
  }
  .job :global(.win__body) {
    padding: 16px;
  }
  .job__role {
    font-size: 22px;
  }
  .job__role .chip {
    font-size: 26px;
    padding: 2px 6px 1px;
    margin-right: 4px;
  }
  .job__where {
    margin-top: 10px;
  }
  .job__tenure {
    margin-top: 2px;
    color: var(--blue);
  }
  .job__summary {
    margin-top: 16px;
    font: 500 16px/1.3 var(--font-sans);
  }
  .job__duties {
    margin-top: 14px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    font: 500 15px/1.3 var(--font-sans);
  }
  .job__duties li {
    position: relative;
    padding-left: 18px;
  }
  .job__duties li::before {
    content: '▪';
    position: absolute;
    left: 2px;
    top: -1px;
    color: var(--blue);
  }
  .job__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 18px;
    border-top: 1px solid var(--ink);
  }
  .job__stats div {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 8px 0 0;
  }
  /* the number reads first, the label underneath */
  .job__stats dd {
    order: -1;
  }
  .job__stats div + div {
    border-left: 1px solid var(--ink);
    padding-left: 8px;
  }
  .job__stats dd {
    font-size: 34px;
    line-height: 0.9;
  }
  .job__stats dt {
    font-size: 17px;
    line-height: 1;
    color: var(--ink-2);
  }

  .projects__label {
    padding-bottom: 12px;
    border-bottom: 1px solid currentColor;
  }
  .xp {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(18px, 2.4vw, 32px);
    padding: 28px 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 45%, transparent);
  }
  .xp__media {
    display: block;
    align-self: start;
    border: 2px solid var(--ink);
    background: var(--ink);
    overflow: hidden;
  }
  .xp__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 1400 / 960;
    object-fit: cover;
    transition: transform 300ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .xp:hover .xp__media img {
      transform: scale(1.03);
    }
    .xp__name a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }
  .xp__meta {
    opacity: 0.85;
  }
  .xp__name {
    margin-top: 10px;
    font-size: clamp(2rem, 3.2vw, 2.75rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
  }
  .xp__name a {
    text-decoration: none;
  }
  .xp__tagline {
    margin-top: 10px;
    font-size: 18px;
    line-height: 1.18;
  }
  .xp__list {
    margin-top: 14px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 7px;
    font-size: 15.5px;
    line-height: 1.28;
    opacity: 0.92;
  }
  .xp__list li {
    position: relative;
    padding-left: 18px;
  }
  .xp__list li::before {
    content: '→';
    position: absolute;
    left: 0;
  }
  .xp .tags {
    margin-top: 16px;
  }

  .highlight {
    margin-top: clamp(96px, 11vw, 160px);
    padding: clamp(28px, 3vw, 40px) clamp(4px, 1vw, 12px);
    overflow: hidden;
  }
  .highlight__lines span {
    display: block;
    width: max-content;
    max-width: 100%;
  }
  .highlight__lines span + span {
    margin-left: auto;
  }
  .highlight__note {
    margin-top: 28px;
    max-width: 60ch;
  }
  .highlight__note a {
    text-underline-offset: 3px;
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .job-col {
      position: static;
    }
  }
  @media (max-width: 640px) {
    .xp {
      grid-template-columns: 1fr;
    }
    .job__stats {
      grid-template-columns: 1fr;
    }
    .job__stats div + div {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--ink);
    }
    .highlight__lines span + span {
      margin-left: 0;
    }
  }
</style>
