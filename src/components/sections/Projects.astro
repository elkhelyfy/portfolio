---
import SectionHead from '../ui/SectionHead.astro';
import Window from '../ui/Window.astro';
import Layers from '../ui/Layers.astro';
import { bySlug, projectsSection } from '../../data/projects';

const projects = projectsSection.projects.map(bySlug);
---

<section id="projects" class="band projects" aria-labelledby="projects-title">
  <div class="wrap">
    <SectionHead
      index="04"
      label={projectsSection.label}
      headline={projectsSection.headline}
      intro={projectsSection.intro}
      id="projects-title"
    />

    <ul class="grid">
      {
        projects.map((p) => (
          <li data-reveal>
            <Window title={`${p.slug}.app`} aside={p.org} tone="white" class="card">
              <a class="card__media" href={`/projects/${p.slug}`} tabindex="-1" aria-hidden="true" data-media>
                <img src={p.image} alt="" width="1400" height="960" loading="lazy" decoding="async" />
              </a>
              <div class="card__body">
                <p class="label card__badge">{p.badge}</p>
                <h3 class="card__name">
                  <a href={`/projects/${p.slug}`}>{p.name}</a>
                </h3>
                <p class="card__tagline">{p.tagline}</p>
                <ul class="card__list">
                  {p.highlights.slice(0, 3).map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
                {p.layers && <Layers layers={p.layers} />}
                <div class="card__foot">
                  <ul class="tags">
                    {p.stack.slice(0, 6).map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                  <a class="more" href={`/projects/${p.slug}`}>
                    Read the case study
                  </a>
                </div>
              </div>
            </Window>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 3.5vw, 48px);
    align-items: start;
  }
  .card {
    box-shadow: 6px 6px 0 var(--ink);
  }
  .card :global(.win__body) {
    padding: 0;
  }
  .card__media {
    display: block;
    overflow: hidden;
    border-bottom: 1px solid var(--ink);
    background: var(--ink);
  }
  .card__media img {
    width: 100%;
    height: auto;
    aspect-ratio: 1400 / 820;
    object-fit: cover;
    transition: transform 300ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .card__media img {
      transform: scale(1.03);
    }
    .card__name a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 4px;
    }
  }
  .card__body {
    display: grid;
    gap: 14px;
    padding: 18px clamp(16px, 2vw, 24px) 22px;
    font-family: var(--font-sans);
  }
  .card__badge {
    color: var(--blue);
  }
  .card__name {
    margin-top: -6px;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 0.92;
    letter-spacing: -0.045em;
  }
  .card__name a {
    text-decoration: none;
  }
  .card__tagline {
    font-size: 18px;
    line-height: 1.18;
  }
  .card__list {
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 15.5px;
    line-height: 1.28;
    color: var(--ink-2);
  }
  .card__list li {
    position: relative;
    padding-left: 18px;
  }
  .card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--ink);
  }
  .card :global(.layers) {
    padding: 14px;
    background: var(--grey);
    border: 1px solid var(--ink);
  }
  .card__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 14px;
    padding-top: 6px;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
