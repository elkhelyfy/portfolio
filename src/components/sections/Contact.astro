---
import SectionHead from '../ui/SectionHead.astro';
import Window from '../ui/Window.astro';
import { contact } from '../../data/contact';
---

<section id="contact" class="band band--dark contact" aria-labelledby="contact-title">
  <div class="wrap">
    <SectionHead index="05" label={contact.label} headline={contact.line} id="contact-title">
      <div class="cta" data-reveal>
        <svg class="arrows" viewBox="0 0 60 22" aria-hidden="true" data-arrows>
          <path d="M0 0l12 11L0 22z" fill="currentColor"></path>
          <path d="M18 0l12 11-12 11z" fill="currentColor"></path>
          <path d="M36 0l12 11-12 11z" fill="currentColor"></path>
        </svg>
        <a class="big-link display-m" href={contact.cta.href}>{contact.cta.label}</a>
      </div>
    </SectionHead>

    <ul class="channels" data-stagger>
      {
        contact.channels.map((c) => (
          <li>
            <Window title={c.title} class="channel">
              {c.clock ? (
                <>
                  <p class="channel__value channel__time" data-clock={c.clock}>
                    --:--
                  </p>
                  <p class="channel__sub">{c.value}</p>
                </>
              ) : (
                <>
                  <p class="channel__value">
                    <a href={c.href} target={c.href?.startsWith('http') || c.href?.endsWith('.pdf') ? '_blank' : undefined} rel="noopener">
                      {c.value}
                    </a>
                  </p>
                  {c.copy && (
                    <button class="win__btn copy" type="button" data-copy={c.copy}>
                      <span class="copy__label" data-label>
                        Copy address
                      </span>
                    </button>
                  )}
                </>
              )}
            </Window>
          </li>
        ))
      }
    </ul>

    <div class="faq">
      <h3 class="label" data-reveal>{contact.faqTitle}</h3>
      <div class="faq__list" data-stagger>
        {
          contact.faq.map((item, i) => (
            <details class="item" open={i === 0}>
              <summary>
                <span>{item.q}</span>
                <svg class="caret" viewBox="0 0 20 20" aria-hidden="true">
                  <rect x="0.5" y="0.5" width="19" height="19" fill="none" stroke="currentColor" />
                  <path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.4" />
                </svg>
              </summary>
              <p class="answer">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  // local time in each [data-clock] zone
  const clocks = [...document.querySelectorAll<HTMLElement>('[data-clock]')];
  if (clocks.length) {
    const tick = () =>
      clocks.forEach((el) => {
        el.textContent = new Intl.DateTimeFormat('en-GB', {
          timeZone: el.dataset.clock,
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
        }).format(new Date());
      });
    tick();
    setInterval(tick, 1000);
  }

  // copy to clipboard, with the label swapping through a short blur
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector<HTMLElement>('[data-label]')!;
    const idle = label.textContent!.trim();
    let timer = 0;
    const swap = (text: string) => {
      label.classList.add('is-swapping');
      window.setTimeout(() => {
        label.textContent = text;
        label.classList.remove('is-swapping');
      }, 110);
    };
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        swap('Copied ✓');
      } catch {
        swap('Press Ctrl+C');
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => swap(idle), 1600);
    });
  });
</script>

<style>
  .contact.band {
    padding-bottom: clamp(48px, 6vw, 80px);
  }
  .cta {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 32px);
    margin-top: clamp(24px, 3vw, 36px);
  }
  .arrows {
    width: clamp(40px, 4.2vw, 58px);
    color: var(--blue-light);
  }

  .channels {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .channel {
    height: 100%;
    border-color: var(--grey-2);
  }
  /* on the dark band an ink title bar would vanish */
  .channel :global(.win__bar) {
    background: var(--blue);
  }
  .channel :global(.win__body) {
    display: grid;
    align-content: space-between;
    gap: 14px;
    min-height: 120px;
  }
  .channel__value {
    font-size: 23px;
    overflow-wrap: anywhere;
  }
  .channel__value a {
    text-underline-offset: 3px;
  }
  .channel__time {
    font-size: 40px;
    line-height: 0.9;
    font-variant-numeric: tabular-nums;
  }
  .channel__sub {
    color: var(--ink-2);
  }
  .copy {
    justify-self: start;
    font-size: 20px;
    padding: 6px 12px 5px;
  }
  .copy__label {
    display: inline-block;
    transition:
      filter 110ms ease,
      opacity 110ms ease;
  }
  .copy__label.is-swapping {
    filter: blur(2px);
    opacity: 0.4;
  }

  .faq {
    margin-top: clamp(80px, 9vw, 120px);
    max-width: 760px;
  }
  .faq > .label {
    padding-bottom: 12px;
    margin-bottom: 28px;
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 40%, transparent);
  }
  .faq__list {
    display: grid;
    gap: 22px;
  }
  .item {
    border-left: 1px dashed color-mix(in srgb, var(--paper) 55%, transparent);
    padding-left: 10px;
  }
  .item[open] {
    border-left-style: solid;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 6px 0 18px;
    font: 700 13px/1.3 var(--font-mono);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .caret {
    flex: none;
    width: 20px;
    height: 20px;
    transform: rotate(180deg);
    transition: transform 200ms var(--ease-out);
  }
  .item[open] .caret {
    transform: none;
  }
  .answer {
    padding: 2px 0 16px;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.18;
    max-width: 40ch;
  }
  @media (hover: hover) and (pointer: fine) {
    summary:hover span {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
  .item::details-content {
    block-size: 0;
    overflow: clip;
    opacity: 0;
    transition:
      block-size 260ms var(--ease-out),
      opacity 200ms ease,
      content-visibility 260ms allow-discrete;
  }
  .item[open]::details-content {
    block-size: auto;
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .item::details-content,
    .caret,
    .copy__label {
      transition: none;
    }
  }

  @media (max-width: 1000px) {
    .channels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .channels {
      grid-template-columns: 1fr;
    }
    .cta {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
